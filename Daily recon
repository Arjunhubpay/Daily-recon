<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Recon Daily</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --ink:#12130f;--paper:#faf9f5;--line:#20221c;
    --slate:#3a4a3f;--moss:#5a7a52;--clay:#b5533a;--amber:#c8892a;
    --grid:#e6e3da;--muted:#6b6d63;--ok:#4a6b3f;--warn:#b5533a;
    --mono:'IBM Plex Mono',ui-monospace,'SF Mono',Menlo,monospace;
    --sans:'Inter','Helvetica Neue',Arial,sans-serif;
  }
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap');
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.5;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1180px;margin:0 auto;padding:32px 24px 80px}

  header{border-bottom:2px solid var(--line);padding-bottom:20px;margin-bottom:28px;display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px}
  .title-block h1{font-size:30px;font-weight:700;letter-spacing:-0.02em;display:flex;align-items:center;gap:12px}
  .title-block .tag{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:0.14em;color:var(--muted);margin-top:6px}
  .datefield{display:flex;flex-direction:column;gap:5px}
  .datefield label{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:0.12em;color:var(--muted)}
  .datefield input{font-family:var(--mono);font-size:14px;padding:8px 10px;border:1.5px solid var(--line);background:var(--paper);border-radius:0}

  /* drop zone */
  .drop{border:2px dashed var(--line);padding:38px 24px;text-align:center;cursor:pointer;transition:.15s;background:repeating-linear-gradient(45deg,transparent,transparent 12px,rgba(90,122,82,.03) 12px,rgba(90,122,82,.03) 24px)}
  .drop:hover,.drop.over{background:rgba(90,122,82,.09);border-color:var(--moss)}
  .drop h2{font-size:17px;font-weight:600;margin-bottom:6px}
  .drop p{color:var(--muted);font-size:13px}
  .drop .mono{font-family:var(--mono);font-size:12px;color:var(--moss);margin-top:10px}

  /* file chips */
  .files{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
  .chip{font-family:var(--mono);font-size:12px;padding:6px 10px;border:1.5px solid var(--line);display:flex;align-items:center;gap:8px;background:#fff}
  .chip.ok{border-color:var(--moss)}
  .chip.unknown{border-color:var(--muted);border-style:dashed;color:var(--muted)}
  .chip .kind{font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);border-left:1px solid var(--grid);padding-left:8px}
  .chip .x{cursor:pointer;color:var(--muted);font-weight:700}
  .chip .x:hover{color:var(--clay)}

  .actions{display:flex;gap:12px;margin-top:22px;align-items:center;flex-wrap:wrap}
  button.run{font-family:var(--mono);font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;background:var(--ink);color:var(--paper);border:none;padding:13px 26px;cursor:pointer;transition:.15s}
  button.run:hover:not(:disabled){background:var(--moss)}
  button.run:disabled{opacity:.35;cursor:not-allowed}
  button.ghost{font-family:var(--mono);font-size:12px;background:none;border:1.5px solid var(--line);padding:12px 18px;cursor:pointer;text-transform:uppercase;letter-spacing:.06em}
  button.ghost:hover{background:var(--ink);color:var(--paper)}
  .hint{font-size:12px;color:var(--muted)}

  /* summary cards */
  .summary{margin-top:36px;display:none}
  .summary.show{display:block}
  .sumgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0;border:2px solid var(--line);margin-bottom:28px}
  .card{padding:18px 20px;border-right:1.5px solid var(--line)}
  .card:last-child{border-right:none}
  .card .lbl{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}
  .card .val{font-size:34px;font-weight:700;letter-spacing:-.02em;margin-top:4px;font-variant-numeric:tabular-nums}
  .card.matched .val{color:var(--ok)}
  .card.exceptions .val{color:var(--warn)}

  /* provider table */
  h3{font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);margin:26px 0 10px;padding-bottom:6px;border-bottom:1.5px solid var(--line)}
  table{width:100%;border-collapse:collapse;font-size:13px}
  th{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);text-align:left;padding:8px 10px;border-bottom:1.5px solid var(--line)}
  td{padding:8px 10px;border-bottom:1px solid var(--grid);font-variant-numeric:tabular-nums}
  tr:hover td{background:rgba(90,122,82,.05)}
  .num{text-align:right}
  .pill{font-family:var(--mono);font-size:11px;padding:2px 8px;display:inline-block}
  .pill.clean{color:var(--ok);border:1px solid var(--ok)}
  .pill.review{color:var(--warn);border:1px solid var(--warn)}
  .method{font-family:var(--mono);font-size:11px;color:var(--slate)}

  /* tabs */
  .tabs{display:flex;gap:0;margin:30px 0 0;border-bottom:2px solid var(--line)}
  .tab{font-family:var(--mono);font-size:12px;text-transform:uppercase;letter-spacing:.08em;padding:11px 18px;cursor:pointer;border:1.5px solid transparent;border-bottom:none;color:var(--muted);position:relative;top:2px}
  .tab.active{color:var(--ink);border-color:var(--line);background:var(--paper);font-weight:600}
  .tab .count{font-size:10px;opacity:.7;margin-left:5px}
  .panel{display:none;padding-top:18px}
  .panel.active{display:block}
  .tablewrap{max-height:460px;overflow:auto;border:1.5px solid var(--grid)}
  .tablewrap table{font-size:12px}
  .tablewrap th{position:sticky;top:0;background:var(--paper);z-index:1}
  .desc{color:var(--warn)}

  .err{background:#fbeae5;border:1.5px solid var(--clay);color:#8a2f1a;padding:12px 16px;font-family:var(--mono);font-size:12px;margin-top:18px;display:none}
  .err.show{display:block}

  .foot{margin-top:40px;font-family:var(--mono);font-size:11px;color:var(--muted);border-top:1px solid var(--grid);padding-top:16px;line-height:1.7}
  @media(max-width:640px){.card{border-right:none;border-bottom:1.5px solid var(--line)}.sumgrid{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="title-block">
      <h1>◧ Recon Daily</h1>
      <div class="tag">Internal ledger × provider statements · reconciliation</div>
    </div>
    <div class="datefield">
      <label for="rundate">Run date</label>
      <input type="date" id="rundate">
    </div>
  </header>

  <div class="drop" id="drop">
    <h2>Drop today's files here</h2>
    <p>Internal recon-lines + all provider statements. CSV and XLSX both work.</p>
    <div class="mono">recon-lines · transactions_report · PaymentHistory · SettlementReport · DealHistory · OpTransactionHistory · downloaded-statement</div>
    <input type="file" id="filein" multiple accept=".csv,.xlsx,.xls" style="display:none">
  </div>

  <div class="files" id="filelist"></div>
  <div class="err" id="err"></div>

  <div class="actions" id="actions" style="display:none">
    <button class="run" id="runbtn">Run reconciliation</button>
    <button class="ghost" id="clearbtn">Clear</button>
    <span class="hint" id="readyhint"></span>
  </div>

  <div class="summary" id="summary">
    <div class="sumgrid">
      <div class="card"><div class="lbl">Internal rows</div><div class="val" id="s-total">0</div></div>
      <div class="card matched"><div class="lbl">Matched</div><div class="val" id="s-matched">0</div></div>
      <div class="card exceptions"><div class="lbl">Exceptions</div><div class="val" id="s-exc">0</div></div>
      <div class="card"><div class="lbl">Match rate</div><div class="val" id="s-rate">0%</div></div>
    </div>

    <h3>By provider</h3>
    <table id="provtable">
      <thead><tr><th>Provider</th><th class="num">Matched</th><th class="num">Exceptions</th><th class="num">Total</th><th>Status</th></tr></thead>
      <tbody></tbody>
    </table>

    <div class="tabs">
      <div class="tab active" data-tab="exc">Exceptions <span class="count" id="t-exc">0</span></div>
      <div class="tab" data-tab="matched">Matched <span class="count" id="t-matched">0</span></div>
    </div>
    <div class="panel active" id="panel-exc">
      <div style="margin-bottom:12px"><button class="ghost" onclick="dl('exc')">Download exceptions CSV</button></div>
      <div class="tablewrap">
        <table><thead><tr><th>Provider</th><th>Internal Ref</th><th>Value Date</th><th class="num">Amount</th><th>Cur</th><th>Type</th><th>Description</th></tr></thead>
        <tbody id="exc-body"></tbody></table>
      </div>
    </div>
    <div class="panel" id="panel-matched">
      <div style="margin-bottom:12px"><button class="ghost" onclick="dl('matched')">Download matched CSV</button></div>
      <div class="tablewrap">
        <table><thead><tr><th>Provider</th><th>Internal Ref</th><th>Provider Ref</th><th>Value Date</th><th class="num">Amount</th><th>Cur</th><th>Method</th></tr></thead>
        <tbody id="matched-body"></tbody></table>
      </div>
    </div>
  </div>

  <div class="foot">
    Matching rules — NBF: FT code · Currency Cloud: Reference, then amount+currency · Corpay: Deal # (from Supplementary Details or Reference) across Payments/Settlements/FX · Zand: Outgoing Id after stripping _UUID, then Ref for Account Owner, then amount.<br>
    Fee rows (Debit_FEE_VAT, Debit_FEE_REMITTANCE_FEE) excluded. All processing happens in your browser — nothing is uploaded.
  </div>
</div>

<script>
// ---------- state ----------
let FILES = {}; // name -> {content, name}
let RESULT = null;
document.getElementById('rundate').value = new Date().toISOString().slice(0,10);

// ---------- helpers (ported 1:1 from the verified script) ----------
function num(x){
  if(x==null) return null;
  let s=String(x).trim().replace(/,/g,'');
  if(s===''||s.toLowerCase()==='nan') return null;
  const neg=s.startsWith('(')&&s.endsWith(')');
  s=s.replace(/[^0-9.\-]/g,'');
  if(s===''||s==='-'||s==='.') return null;
  const v=parseFloat(s); if(isNaN(v)) return null;
  return neg?-v:v;
}
const amtKey=v=>v==null?null:Math.round(v*100)/100;
const FT_RE=/FT[0-9]{5}[A-Z0-9]{5}/;
const extractFT=t=>{const m=t?String(t).match(FT_RE):null;return m?m[0]:null;};
const stripZand=r=>r==null?'':String(r).trim().replace(/_[0-9a-fA-F]{8}$/,'');

function parseCSV(text){
  text=text.replace(/^\uFEFF/,'').replace(/\r\n/g,'\n').replace(/\r/g,'\n');
  const rows=[];let row=[],f='',q=false;
  for(let i=0;i<text.length;i++){const c=text[i];
    if(q){if(c==='"'){if(text[i+1]==='"'){f+='"';i++;}else q=false;}else f+=c;}
    else{if(c==='"')q=true;else if(c===','){row.push(f);f='';}
      else if(c==='\n'){row.push(f);rows.push(row);row=[];f='';}else f+=c;}
  }
  if(f!==''||row.length){row.push(f);rows.push(row);}
  return rows;
}
function toObjects(text,skip){
  const rows=parseCSV(text);if(rows.length<=skip)return [];
  const H=rows[skip].map(h=>h.trim());const out=[];
  for(let r=skip+1;r<rows.length;r++){const c=rows[r];
    if(c.length===1&&c[0].trim()==='')continue;
    const o={};H.forEach((h,i)=>o[h]=(c[i]??'').trim());out.push(o);}
  return out;
}
const pick=kw=>{const k=Object.keys(FILES).find(n=>n.toLowerCase().includes(kw.toLowerCase()));return k?FILES[k].content:'';};
const pickAll=kw=>Object.keys(FILES).filter(n=>n.toLowerCase().includes(kw.toLowerCase())).map(n=>FILES[n]);

// ---------- file type detection ----------
const KEYWORDS=[
  ['recon-lines','Internal'],['transactions_report','Currency Cloud'],
  ['PaymentHistory','Corpay Payments'],['SettlementReport','Corpay Settlements'],
  ['DealHistory','Corpay FX'],['OpTransactionHistory','NBF'],['downloaded-statement','Zand']
];
function detect(name){const m=KEYWORDS.find(([k])=>name.toLowerCase().includes(k.toLowerCase()));return m?m[1]:null;}

// ---------- reconciliation (ported 1:1) ----------
function reconcile(runDate){
  const internalRaw=toObjects(pick('recon-lines'),0);
  if(!internalRaw.length) throw new Error('No recon-lines (internal) file found, or it is empty.');
  const FEE=new Set(['Debit_FEE_VAT','Debit_FEE_REMITTANCE_FEE']);
  const internal=internalRaw.filter(r=>!FEE.has(r['Transaction Type']));
  const intRows=p=>internal.filter(r=>r['Payment Provider']===p);

  // Currency Cloud
  const ccByRef={};
  toObjects(pick('transactions_report'),0).forEach(r=>{const k=(r['Reference']||'').trim();(ccByRef[k]=ccByRef[k]||[]).push(r);});

  // Corpay (pickAll so multiple files of same type all load)
  function corpayIndex(kw,amtCol,paidOnly){
    const idx={};
    pickAll(kw).forEach(f=>toObjects(f.content,0).forEach(r=>{
      if(paidOnly&&(r['Status']||'').trim().toLowerCase()!=='paid')return;
      const deal=(r['Deal #']||'').trim();
      if(deal)(idx[deal]=idx[deal]||[]).push({amt:num(r[amtCol])});
    }));
    return idx;
  }
  const cpPay=corpayIndex('PaymentHistory','Amount',false);
  const cpSetl=corpayIndex('SettlementReport','Settlement Amount',true);
  const cpFx=corpayIndex('DealHistory','Purchased',false);
  const cpAll=new Set([...Object.keys(cpPay),...Object.keys(cpSetl),...Object.keys(cpFx)]);

  // NBF
  const nbfIdx={};
  pickAll('OpTransactionHistory').forEach(f=>{
    const rows=toObjects(f.content,7);
    const dk=Object.keys(rows[0]||{}).find(k=>k.indexOf('Description')>=0)||'';
    rows.forEach(r=>{const desc=r[dk]||'';if(desc.toLowerCase().indexOf('computer generated')>=0)return;
      const ft=extractFT(desc);if(!ft)return;(nbfIdx[ft]=nbfIdx[ft]||[]).push(1);});
  });

  // Zand
  const zandIdx={};
  pickAll('downloaded-statement').forEach(f=>{
    toObjects(f.content,0).forEach(r=>{const oid=(r['Outgoing Id']||'').trim();if(!oid)return;
      const amt=num(r['Credit'])??num(r['Debit']);(zandIdx[oid]=zandIdx[oid]||[]).push({amt});});
  });

  const exceptions=[],matched=[];
  const recM=(prov,ir,pref,method)=>matched.push({Provider:prov,'Internal Ref':ir['Reference']||'','Provider Ref':pref,'Value Date':ir['Value Date']||'',Amount:ir['Amount']||'',Currency:ir['Currency']||'','Match Method':method});
  const recE=(prov,ir,type,desc)=>exceptions.push({Provider:prov,'Internal Ref':ir['Reference']||'','Value Date':ir['Value Date']||'',Amount:ir['Amount']||'',Currency:ir['Currency']||'',Type:ir['Transaction Type']||'','Exception Type':type,Description:desc});

  intRows('NBF').forEach(ir=>{const ref=(ir['Reference']||'').trim();
    if(nbfIdx[ref])recM('NBF',ir,ref,'FT code');else recE('NBF',ir,'Missing in Provider','FT '+ref+' not in NBF statements');});

  intRows('CURRENCY_CLOUD').forEach(ir=>{const ref=(ir['Reference']||'').trim();
    if(ccByRef[ref]){recM('Currency Cloud',ir,ref,'Reference');return;}
    const amt=amtKey(num(ir['Amount'])),cur=ir['Currency'];let hit=null;
    for(const k in ccByRef)for(const r of ccByRef[k])if(amtKey(num(r['Amount']))===amt&&r['Currency']===cur){hit=r;break;}
    if(hit)recM('Currency Cloud',ir,hit['Reference']||'','Amount+Currency');else recE('Currency Cloud',ir,'Missing in Provider','Ref '+ref+' not found');});

  intRows('CORPAY').forEach(ir=>{const sd=(ir['Supplementary Details']||'').trim();const ref=(ir['Reference']||'').trim();
    const deal=/^\d+$/.test(sd)?sd:(/^\d+$/.test(ref)?ref:'');
    if(deal&&cpAll.has(deal)){const w=cpPay[deal]?'Payments':(cpSetl[deal]?'Settlements':'FX Deals');recM('Corpay',ir,deal,'Deal # ('+w+')');}
    else recE('Corpay',ir,'Missing in Provider','Deal '+(deal||ref)+' not in Corpay files');});

  intRows('ZAND').forEach(ir=>{const clean=stripZand(ir['Reference']);const rfao=(ir['Ref for Account Owner']||'').trim();
    if(zandIdx[clean]){recM('Zand',ir,clean,'Outgoing Id');return;}
    if(zandIdx[rfao]){recM('Zand',ir,rfao,'Ref for Account Owner');return;}
    const amt=amtKey(num(ir['Amount']));let hit=null;
    for(const k in zandIdx)for(const r of zandIdx[k])if(amtKey(r.amt)===amt){hit=k;break;}
    if(hit)recM('Zand',ir,hit,'Amount');else recE('Zand',ir,'Missing in Provider','Outgoing Id '+clean+' not found');});

  const provs=['NBF','Currency Cloud','Corpay','Zand'];
  const perProvider=provs.map(p=>({provider:p,matched:matched.filter(m=>m.Provider===p).length,exceptions:exceptions.filter(e=>e.Provider===p).length}));
  return {runDate,matched,exceptions,perProvider,internalCount:internal.length};
}

// ---------- file reading ----------
function readFile(file){
  return new Promise((res,rej)=>{
    const ext=file.name.toLowerCase().split('.').pop();
    const rd=new FileReader();
    rd.onerror=()=>rej(new Error('Could not read '+file.name));
    if(ext==='xlsx'||ext==='xls'){
      rd.onload=e=>{try{
        const wb=XLSX.read(new Uint8Array(e.target.result),{type:'array'});
        const ws=wb.Sheets[wb.SheetNames[0]];
        const csv=XLSX.utils.sheet_to_csv(ws);
        res({name:file.name.replace(/\.(xlsx|xls)$/i,'.csv'),content:csv});
      }catch(err){rej(new Error('Failed to parse xlsx: '+file.name));}};
      rd.readAsArrayBuffer(file);
    }else{
      rd.onload=e=>res({name:file.name,content:e.target.result});
      rd.readAsText(file);
    }
  });
}

// ---------- UI ----------
const drop=document.getElementById('drop'),filein=document.getElementById('filein');
const filelist=document.getElementById('filelist'),actions=document.getElementById('actions');
const err=document.getElementById('err');
drop.onclick=()=>filein.click();
drop.ondragover=e=>{e.preventDefault();drop.classList.add('over');};
drop.ondragleave=()=>drop.classList.remove('over');
drop.ondrop=e=>{e.preventDefault();drop.classList.remove('over');addFiles(e.dataTransfer.files);};
filein.onchange=e=>addFiles(e.target.files);

async function addFiles(fileList){
  err.classList.remove('show');
  for(const f of fileList){
    try{const parsed=await readFile(f);FILES[parsed.name]=parsed;}
    catch(e){showErr(e.message);}
  }
  renderFiles();
}
function showErr(m){err.textContent=m;err.classList.add('show');}
function renderFiles(){
  const names=Object.keys(FILES);
  filelist.innerHTML=names.map(n=>{
    const kind=detect(n);
    const cls=kind?(kind==='Internal'?'ok':'ok'):'unknown';
    return `<div class="chip ${cls}"><span>${n}</span><span class="kind">${kind||'unrecognized'}</span><span class="x" onclick="rm('${n.replace(/'/g,"\\'")}')">✕</span></div>`;
  }).join('');
  actions.style.display=names.length?'flex':'none';
  // readiness hint
  const have=new Set(names.map(detect).filter(Boolean));
  const need=['Internal','Currency Cloud','NBF','Zand'];
  const missing=need.filter(x=>x!=='Internal'&&![...have].some(h=>h===x));
  const hint=document.getElementById('readyhint');
  if(!have.has('Internal')) hint.textContent='⚠ Need the internal recon-lines file';
  else if(missing.length) hint.textContent='⚠ No files detected for: '+missing.join(', ')+' — those providers will show as exceptions';
  else hint.textContent='Ready';
}
window.rm=n=>{delete FILES[n];renderFiles();};
document.getElementById('clearbtn').onclick=()=>{FILES={};RESULT=null;renderFiles();document.getElementById('summary').classList.remove('show');};

document.getElementById('runbtn').onclick=()=>{
  err.classList.remove('show');
  try{
    const rd=document.getElementById('rundate').value||new Date().toISOString().slice(0,10);
    RESULT=reconcile(rd);
    render(RESULT);
  }catch(e){showErr(e.message);}
};

function render(R){
  document.getElementById('summary').classList.add('show');
  document.getElementById('s-total').textContent=R.internalCount;
  document.getElementById('s-matched').textContent=R.matched.length;
  document.getElementById('s-exc').textContent=R.exceptions.length;
  document.getElementById('s-rate').textContent=R.internalCount?Math.round(100*R.matched.length/R.internalCount)+'%':'—';

  const pt=document.querySelector('#provtable tbody');
  pt.innerHTML=R.perProvider.map(p=>{
    const clean=p.exceptions===0;
    return `<tr><td>${p.provider}</td><td class="num">${p.matched}</td><td class="num">${p.exceptions}</td><td class="num">${p.matched+p.exceptions}</td><td><span class="pill ${clean?'clean':'review'}">${clean?'clean':'review'}</span></td></tr>`;
  }).join('');

  document.getElementById('t-exc').textContent=R.exceptions.length;
  document.getElementById('t-matched').textContent=R.matched.length;
  document.getElementById('exc-body').innerHTML=R.exceptions.map(e=>
    `<tr><td>${e.Provider}</td><td>${e['Internal Ref']}</td><td>${e['Value Date']}</td><td class="num">${e.Amount}</td><td>${e.Currency}</td><td>${e.Type}</td><td class="desc">${e.Description}</td></tr>`).join('')
    ||'<tr><td colspan="7" style="text-align:center;color:var(--ok);padding:24px">No exceptions — everything matched.</td></tr>';
  document.getElementById('matched-body').innerHTML=R.matched.map(m=>
    `<tr><td>${m.Provider}</td><td>${m['Internal Ref']}</td><td>${m['Provider Ref']}</td><td>${m['Value Date']}</td><td class="num">${m.Amount}</td><td>${m.Currency}</td><td class="method">${m['Match Method']}</td></tr>`).join('');
}

// tabs
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
  t.classList.add('active');
  document.getElementById('panel-'+t.dataset.tab).classList.add('active');
});

// download
window.dl=which=>{
  if(!RESULT)return;
  let rows,head,fn;
  if(which==='exc'){
    head=['Run Date','Provider','Internal Ref','Value Date','Amount','Currency','Type','Exception Type','Description'];
    rows=RESULT.exceptions.map(e=>[RESULT.runDate,e.Provider,e['Internal Ref'],e['Value Date'],e.Amount,e.Currency,e.Type,e['Exception Type'],e.Description]);
    fn='exceptions_'+RESULT.runDate+'.csv';
  }else{
    head=['Run Date','Provider','Internal Ref','Provider Ref','Value Date','Amount','Currency','Match Method'];
    rows=RESULT.matched.map(m=>[RESULT.runDate,m.Provider,m['Internal Ref'],m['Provider Ref'],m['Value Date'],m.Amount,m.Currency,m['Match Method']]);
    fn='matched_'+RESULT.runDate+'.csv';
  }
  const esc=v=>{v=String(v??'');return /[",\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v;};
  const csv=[head.map(esc).join(','),...rows.map(r=>r.map(esc).join(','))].join('\n');
  const blob=new Blob([csv],{type:'text/csv'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=fn;a.click();
};
</script>
</body>
</html>
